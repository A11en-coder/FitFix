generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  MANAGER
  STAFF
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EquipmentStatus {
  AVAILABLE
  LIMITED
  OUT_OF_SERVICE
  ARCHIVED
}

enum FaultSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultStatus {
  REPORTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FaultUpdateType {
  COMMENT
  STATUS
  ASSIGNMENT
  RESOLUTION
  REOPEN
}

enum MediaState {
  DRAFT
  ATTACHED
  DELETE_PENDING
  DELETED
}

enum NotificationType {
  FAULT_ASSIGNED
  FAULT_RESOLVED
  FAULT_CLOSED
  FAULT_REOPENED
}

model Gym {
  id                  String               @id @default(uuid()) @db.Uuid
  clerkOrganizationId String               @unique @db.VarChar(120)
  name                String               @db.VarChar(120)
  slug                String               @unique @db.VarChar(80)
  timeZone            String               @db.VarChar(64)
  currencyCode        String               @default("AUD") @db.Char(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  members             GymMember[]
  invitations         StaffInvitation[]
  auditEvents         AuditEvent[]
  equipment           Equipment[]
  faultDrafts         FaultDraft[]
  faults              FaultReport[]
  faultUpdates        FaultUpdate[]
  mediaAssets         MediaAsset[]
  externalTechnicians ExternalTechnician[]
  notifications       Notification[]
}

model UserProfile {
  id          String      @id @default(uuid()) @db.Uuid
  clerkUserId String      @unique @db.VarChar(120)
  displayName String      @db.VarChar(120)
  email       String      @db.VarChar(254)
  deletedAt   DateTime?   @db.Timestamptz(3)
  memberships GymMember[]
}

model GymMember {
  id                       String                    @id @default(uuid()) @db.Uuid
  gymId                    String                    @db.Uuid
  userId                   String                    @db.Uuid
  role                     MemberRole                @default(STAFF)
  status                   MemberStatus              @default(INVITED)
  joinedAt                 DateTime?                 @db.Timestamptz(3)
  deactivatedAt            DateTime?                 @db.Timestamptz(3)
  gym                      Gym                       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user                     UserProfile               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentInvitations          StaffInvitation[]
  auditEvents              AuditEvent[]
  equipmentStatusIntervals EquipmentStatusInterval[]
  faultDrafts              FaultDraft[]
  reportedFaults           FaultReport[]
  faultUpdates             FaultUpdate[]
  uploadedMedia            MediaAsset[]
  assignedFaults           FaultReport[]             @relation("InternalFaultAssignee")
  notifications            Notification[]

  @@unique([gymId, userId])
  @@index([gymId])
  @@index([userId, status])
}

model StaffInvitation {
  id                String                @id @default(uuid()) @db.Uuid
  gymId             String                @db.Uuid
  invitedByMemberId String                @db.Uuid
  clerkInvitationId String                @unique @db.VarChar(120)
  idempotencyKey    String                @db.VarChar(160)
  email             String                @db.VarChar(254)
  role              MemberRole            @default(STAFF)
  status            StaffInvitationStatus @default(PENDING)
  expiresAt         DateTime              @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  gym               Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  invitedByMember   GymMember             @relation(fields: [invitedByMemberId], references: [id], onDelete: Restrict)

  @@unique([gymId, idempotencyKey])
  @@index([gymId, status])
  @@index([gymId, email, status])
}

model AuditEvent {
  id            String     @id @default(uuid()) @db.Uuid
  gymId         String     @db.Uuid
  actorMemberId String?    @db.Uuid
  entityType    String     @db.VarChar(80)
  entityId      String     @db.Uuid
  action        String     @db.VarChar(80)
  metadata      Json       @default("{}")
  requestId     String     @db.VarChar(64)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  gym           Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  actorMember   GymMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
  @@index([entityType, entityId])
}

model Equipment {
  id              String                    @id @default(uuid()) @db.Uuid
  gymId           String                    @db.Uuid
  publicId        String                    @unique @db.VarChar(26)
  assetId         String                    @db.VarChar(50)
  name            String                    @db.VarChar(120)
  category        String                    @db.VarChar(80)
  location        String                    @db.VarChar(80)
  description     String?                   @db.Text
  currentStatus   EquipmentStatus           @default(AVAILABLE)
  version         Int                       @default(1)
  archivedAt      DateTime?                 @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  gym             Gym                       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  statusIntervals EquipmentStatusInterval[]
  faultDrafts     FaultDraft[]
  faults          FaultReport[]

  @@unique([gymId, assetId])
  @@index([gymId, currentStatus])
  @@index([gymId, name])
  @@index([gymId, category, location])
}

model ExternalTechnician {
  id         String        @id @default(uuid()) @db.Uuid
  gymId      String        @db.Uuid
  name       String        @db.VarChar(120)
  company    String?       @db.VarChar(160)
  email      String?       @db.VarChar(254)
  phone      String?       @db.VarChar(40)
  archivedAt DateTime?     @db.Timestamptz(3)
  gym        Gym           @relation(fields: [gymId], references: [id], onDelete: Restrict)
  faults     FaultReport[]

  @@index([gymId, archivedAt])
  @@index([gymId, name])
}

model EquipmentStatusInterval {
  id                String          @id @default(uuid()) @db.Uuid
  equipmentId       String          @db.Uuid
  status            EquipmentStatus
  startedAt         DateTime        @default(now()) @db.Timestamptz(3)
  endedAt           DateTime?       @db.Timestamptz(3)
  sourceFaultId     String?         @db.Uuid
  changedByMemberId String          @db.Uuid
  equipment         Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  changedByMember   GymMember       @relation(fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([equipmentId, startedAt])
  @@index([equipmentId, endedAt])
}

model FaultDraft {
  id              String           @id @default(uuid()) @db.Uuid
  gymId           String           @db.Uuid
  authorMemberId  String           @db.Uuid
  equipmentId     String?          @db.Uuid
  title           String?          @db.VarChar(160)
  description     String?          @db.Text
  severity        FaultSeverity?
  equipmentStatus EquipmentStatus?
  immediateAction String?          @db.Text
  discoveredAt    DateTime?        @db.Timestamptz(3)
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  gym             Gym              @relation(fields: [gymId], references: [id], onDelete: Restrict)
  authorMember    GymMember        @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)
  equipment       Equipment?       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  mediaAssets     MediaAsset[]

  @@index([gymId, authorMemberId, updatedAt])
  @@index([updatedAt])
  @@index([equipmentId])
}

model FaultReport {
  id                      String              @id @default(uuid()) @db.Uuid
  gymId                   String              @db.Uuid
  publicReference         String              @unique @db.VarChar(24)
  idempotencyKey          String              @db.VarChar(160)
  idempotencyFingerprint  String              @db.Char(64)
  equipmentId             String              @db.Uuid
  reporterMemberId        String              @db.Uuid
  title                   String              @db.VarChar(160)
  description             String              @db.Text
  severity                FaultSeverity
  status                  FaultStatus         @default(REPORTED)
  reportedEquipmentStatus EquipmentStatus
  immediateAction         String?             @db.Text
  discoveredAt            DateTime            @db.Timestamptz(3)
  assigneeMemberId        String?             @db.Uuid
  externalTechnicianId    String?             @db.Uuid
  targetDate              DateTime?           @db.Date
  resolutionSummary       String?             @db.Text
  repairCost              Decimal?            @db.Decimal(12, 2)
  resolvedAt              DateTime?           @db.Timestamptz(3)
  closedAt                DateTime?           @db.Timestamptz(3)
  version                 Int                 @default(1)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  gym                     Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  equipment               Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reporterMember          GymMember           @relation(fields: [reporterMemberId], references: [id], onDelete: Restrict)
  assigneeMember          GymMember?          @relation("InternalFaultAssignee", fields: [assigneeMemberId], references: [id], onDelete: Restrict)
  externalTechnician      ExternalTechnician? @relation(fields: [externalTechnicianId], references: [id], onDelete: Restrict)
  mediaAssets             MediaAsset[]
  updates                 FaultUpdate[]
  notifications           Notification[]

  @@unique([gymId, idempotencyKey])
  @@index([gymId, status, severity])
  @@index([gymId, equipmentId, createdAt])
  @@index([gymId, reporterMemberId])
}

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  gymId             String           @db.Uuid
  recipientMemberId String           @db.Uuid
  faultId           String           @db.Uuid
  type              NotificationType
  title             String           @db.VarChar(160)
  body              String           @db.Text
  destination       String           @db.VarChar(500)
  dedupeKey         String           @unique @db.VarChar(160)
  readAt            DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  gym               Gym              @relation(fields: [gymId], references: [id], onDelete: Restrict)
  recipientMember   GymMember        @relation(fields: [recipientMemberId], references: [id], onDelete: Restrict)
  fault             FaultReport      @relation(fields: [faultId], references: [id], onDelete: Restrict)

  @@index([gymId, recipientMemberId, readAt, createdAt])
  @@index([faultId, createdAt])
}

model FaultUpdate {
  id             String          @id @default(uuid()) @db.Uuid
  faultId        String          @db.Uuid
  gymId          String          @db.Uuid
  authorMemberId String?         @db.Uuid
  type           FaultUpdateType @default(COMMENT)
  body           String?         @db.Text
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  fault          FaultReport     @relation(fields: [faultId], references: [id], onDelete: Restrict)
  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  authorMember   GymMember?      @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([faultId, createdAt])
  @@index([gymId, createdAt])
}

model MediaAsset {
  id                 String       @id @default(uuid()) @db.Uuid
  gymId              String       @db.Uuid
  uploadedByMemberId String       @db.Uuid
  cloudinaryPublicId String       @unique @db.VarChar(255)
  secureUrl          String       @db.Text
  mimeType           String       @db.VarChar(64)
  bytes              Int
  width              Int
  height             Int
  state              MediaState   @default(DRAFT)
  draftId            String?      @db.Uuid
  faultId            String?      @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  gym                Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  uploadedByMember   GymMember    @relation(fields: [uploadedByMemberId], references: [id], onDelete: Restrict)
  draft              FaultDraft?  @relation(fields: [draftId], references: [id], onDelete: Restrict)
  fault              FaultReport? @relation(fields: [faultId], references: [id], onDelete: Restrict)

  @@index([gymId, state, createdAt])
  @@index([draftId, state])
  @@index([faultId, state])
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  provider        String        @default("CLERK") @db.VarChar(32)
  providerEventId String        @db.VarChar(255)
  eventType       String        @db.VarChar(120)
  receivedAt      DateTime      @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?     @db.Timestamptz(3)
  status          WebhookStatus @default(RECEIVED)
  errorCode       String?       @db.VarChar(120)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}
