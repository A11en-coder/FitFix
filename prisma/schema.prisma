generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  MANAGER
  STAFF
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EquipmentStatus {
  AVAILABLE
  LIMITED
  OUT_OF_SERVICE
  ARCHIVED
}

model Gym {
  id                  String      @id @default(uuid()) @db.Uuid
  clerkOrganizationId String      @unique @db.VarChar(120)
  name                String      @db.VarChar(120)
  slug                String      @unique @db.VarChar(80)
  timeZone            String      @db.VarChar(64)
  currencyCode        String      @default("AUD") @db.Char(3)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)
  members             GymMember[]
  invitations         StaffInvitation[]
  auditEvents         AuditEvent[]
  equipment           Equipment[]
}

model UserProfile {
  id          String       @id @default(uuid()) @db.Uuid
  clerkUserId String       @unique @db.VarChar(120)
  displayName String       @db.VarChar(120)
  email       String       @db.VarChar(254)
  deletedAt   DateTime?    @db.Timestamptz(3)
  memberships GymMember[]
}

model GymMember {
  id            String       @id @default(uuid()) @db.Uuid
  gymId         String       @db.Uuid
  userId        String       @db.Uuid
  role          MemberRole   @default(STAFF)
  status        MemberStatus @default(INVITED)
  joinedAt      DateTime?    @db.Timestamptz(3)
  deactivatedAt DateTime?    @db.Timestamptz(3)
  gym           Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user          UserProfile  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentInvitations StaffInvitation[]
  auditEvents     AuditEvent[]
  equipmentStatusIntervals EquipmentStatusInterval[]

  @@index([gymId])
  @@index([userId, status])
  @@unique([gymId, userId])
}

model StaffInvitation {
  id               String                @id @default(uuid()) @db.Uuid
  gymId            String                @db.Uuid
  invitedByMemberId String                @db.Uuid
  clerkInvitationId String               @unique @db.VarChar(120)
  idempotencyKey   String                @db.VarChar(160)
  email            String                @db.VarChar(254)
  role             MemberRole            @default(STAFF)
  status           StaffInvitationStatus @default(PENDING)
  expiresAt        DateTime              @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  gym              Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  invitedByMember  GymMember             @relation(fields: [invitedByMemberId], references: [id], onDelete: Restrict)

  @@unique([gymId, idempotencyKey])
  @@index([gymId, status])
  @@index([gymId, email, status])
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  gymId         String      @db.Uuid
  actorMemberId String?     @db.Uuid
  entityType    String      @db.VarChar(80)
  entityId      String      @db.Uuid
  action        String      @db.VarChar(80)
  metadata      Json        @default("{}")
  requestId     String      @db.VarChar(64)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  gym           Gym         @relation(fields: [gymId], references: [id], onDelete: Restrict)
  actorMember   GymMember?  @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
  @@index([entityType, entityId])
}

model Equipment {
  id            String          @id @default(uuid()) @db.Uuid
  gymId         String          @db.Uuid
  publicId      String          @unique @db.VarChar(26)
  assetId       String          @db.VarChar(50)
  name          String          @db.VarChar(120)
  category      String          @db.VarChar(80)
  location      String          @db.VarChar(80)
  description   String?         @db.Text
  currentStatus EquipmentStatus @default(AVAILABLE)
  version       Int             @default(1)
  archivedAt    DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  gym           Gym             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  statusIntervals EquipmentStatusInterval[]

  @@unique([gymId, assetId])
  @@index([gymId, currentStatus])
  @@index([gymId, name])
  @@index([gymId, category, location])
}

model EquipmentStatusInterval {
  id              String          @id @default(uuid()) @db.Uuid
  equipmentId     String          @db.Uuid
  status          EquipmentStatus
  startedAt       DateTime        @default(now()) @db.Timestamptz(3)
  endedAt         DateTime?       @db.Timestamptz(3)
  sourceFaultId   String?         @db.Uuid
  changedByMemberId String        @db.Uuid
  equipment       Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  changedByMember GymMember       @relation(fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([equipmentId, startedAt])
  @@index([equipmentId, endedAt])
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  provider        String        @default("CLERK") @db.VarChar(32)
  providerEventId String        @db.VarChar(255)
  eventType       String        @db.VarChar(120)
  receivedAt      DateTime      @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?     @db.Timestamptz(3)
  status          WebhookStatus @default(RECEIVED)
  errorCode       String?       @db.VarChar(120)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}
